# Prithvi SEO Portal — frontend env (Section 10 of the build doc)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Prithvi SEO Portal

# Dev-only fallback bearer token used by lib/api.ts when no token is in
# localStorage. In the portal proper this comes from the Supabase Auth
# session; for local development paste an API token (pse_...) or a JWT.
NEXT_PUBLIC_API_TOKEN=
